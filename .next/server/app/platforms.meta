{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/platforms/layout,_N_T_/platforms/page,_N_T_/platforms"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/platforms/__PAGE__",
    "/platforms",
    "/_index",
    "/_head"
  ]
}